# Supabase Storage — required by the Documents module.
# SUPABASE_URL is the project URL (Settings → API), e.g. https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS: server-side only, never expose it.
# Create a storage bucket named "documents" before uploading.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

