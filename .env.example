# ---------------------------------------------------------------------------
# Database — Postgres connection string used by Prisma.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/praxis

# ---------------------------------------------------------------------------
# Auth — NextAuth.
# NEXTAUTH_SECRET: generate with `openssl rand -base64 32`.
# NEXTAUTH_URL: the deployment's public origin. Set this to the real HTTPS URL
# in production (e.g. https://praxis.example.com) or OAuth callbacks will fail.
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=replace-with-a-32-byte-random-string
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google OAuth (optional). Both must be set for the "Continue with Google"
# button to appear — the provider is skipped when either is missing.
# Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# AI providers.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

# ---------------------------------------------------------------------------
# Supabase Storage — required by Documents, Meetings, Resumes and avatars.
# SUPABASE_URL is the project URL (Settings → API), e.g. https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS: server-side only, never expose it.
# Create private buckets named "documents", "meetings" and "avatars".
# NEXT_PUBLIC_SUPABASE_URL is an optional fallback for SUPABASE_URL.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# ---------------------------------------------------------------------------
# Transactional email — Brevo. Powers workflow notifications and the landing
# page contact form.
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Praxis

# Destination inbox for landing page contact submissions.
# Falls back to BREVO_SENDER_EMAIL when unset.
CONTACT_INBOX_EMAIL=

# ---------------------------------------------------------------------------
# Optional tuning.
# STORAGE_QUOTA_MB: storage allowance shown on the Analytics page (default 1024).
# ---------------------------------------------------------------------------
STORAGE_QUOTA_MB=1024
