generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL: Supabase transaction pooler (6543, ?pgbouncer=true) on Vercel,
  // where many short-lived serverless invocations need pooled connections; the
  // session pooler (5432) on Render, where the worker is one persistent process.
  // directUrl bypasses pgbouncer for `prisma migrate deploy`, which the
  // transaction pooler cannot run DDL through.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum WorkflowRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum DocumentStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ReportType {
  EMPLOYEE
  WORKFLOW
  SALES
  HR
  AI_USAGE
}

enum ChatRole {
  USER
  ASSISTANT
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  SLACK
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum MeetingStatus {
  PENDING
  TRANSCRIBING
  PROCESSED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  /// Null for accounts created through an OAuth provider — those users have no
  /// password and can never sign in through the credentials form.
  passwordHash String?  @map("password_hash")
  name         String
  role         Role     @default(EMPLOYEE)
  createdAt    DateTime @default(now()) @map("created_at")
  lastLogin    DateTime? @map("last_login")

  /// Legacy column. The "avatars" bucket is private, so the public URL this
  /// used to hold was never fetchable; photos are now served from avatarPath
  /// through /api/avatars/[userId]. Written as null on every upload.
  avatarUrl    String?  @map("avatar_url")
  /// Object key inside the private "avatars" bucket. The source of truth for
  /// an uploaded photo — see effectiveAvatar() in lib/auth/avatar.ts.
  avatarPath   String?  @map("avatar_path")
  /// Photo supplied by the OAuth provider, refreshed on every sign-in. Used
  /// only when avatarUrl is null — an uploaded photo always wins.
  oauthAvatarUrl String? @map("oauth_avatar_url")

  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")

  sessions             Session[]
  activityLogs         ActivityLog[]
  workflows            Workflow[]
  documents            Document[]
  reports              Report[]
  chatMessages         ChatMessage[]
  marketplaceTemplates MarketplaceTemplate[]
  notifications        Notification[]
  apiConnections       ApiConnection[]
  meetings             Meeting[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("sessions")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String
  meta      Json
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model Workflow {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  name      String
  nodes     Json
  edges     Json
  status    WorkflowStatus @default(DRAFT)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id])
  runs           WorkflowRun[]
  scheduledJobs  ScheduledJob[]

  @@map("workflows")
}

model WorkflowRun {
  id         String            @id @default(uuid())
  workflowId String            @map("workflow_id")
  status     WorkflowRunStatus @default(RUNNING)
  input      Json
  output     Json?
  error      String?
  startedAt  DateTime          @default(now()) @map("started_at")
  finishedAt DateTime?         @map("finished_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_runs")
}

model Document {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  fileName      String   @map("file_name")
  fileUrl       String   @map("file_url")
  fileType      String   @map("file_type")
  extractedText String?  @map("extracted_text")
  aiSummary     String?  @map("ai_summary")
  tags          String[]
  createdAt     DateTime @default(now()) @map("created_at")

  /// Object key inside the "documents" storage bucket — kept so delete and
  /// signed-URL generation don't have to parse it back out of fileUrl.
  storagePath String?        @map("storage_path")
  fileSize    Int?           @map("file_size")
  status      DocumentStatus @default(PENDING)
  /// Why extraction/summarisation failed, surfaced to the UI on FAILED.
  statusMessage String?      @map("status_message")

  user    User     @relation(fields: [userId], references: [id])
  resumes Resume[]

  @@index([userId])
  @@map("documents")
}

model Resume {
  id            String   @id @default(uuid())
  documentId    String   @map("document_id")
  candidateName String   @map("candidate_name")
  skills        String[]
  jdMatchScore  Float    @map("jd_match_score")
  ranking       Int
  createdAt     DateTime @default(now()) @map("created_at")

  /// Groups every candidate scored in one "Screen Candidates" request, so
  /// rankings from separate screenings don't interleave in the results table.
  screeningId String @map("screening_id")
  /// The JD this candidate was scored against — kept so interview questions
  /// can be generated later without asking the user to paste it again.
  jobDescription String @map("job_description")

  // Fields below are all filled by the same scoring call, so they cost no
  // extra AI requests. Nullable: the model may not find them in a resume.
  email           String?
  summary         String?
  currentRole     String?  @map("current_role")
  education       String?
  yearsExperience Float?   @map("years_experience")
  skillsMissing   String[] @map("skills_missing")
  /// Cached so re-opening a candidate doesn't re-spend an AI call.
  interviewQuestions String[] @map("interview_questions")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([screeningId])
  @@map("resumes")
}

model Report {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  type        ReportType
  fileUrl     String     @map("file_url")
  generatedAt DateTime   @default(now()) @map("generated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("reports")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  role      ChatRole
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("chat_messages")
}

model MarketplaceTemplate {
  id           String @id @default(uuid())
  name         String
  description  String
  category     String
  workflowJson Json   @map("workflow_json")
  createdBy    String @map("created_by")

  creator User @relation(fields: [createdBy], references: [id])

  @@map("marketplace_templates")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  type      NotificationType
  message   String
  status    NotificationStatus  @default(PENDING)
  createdAt DateTime            @default(now()) @map("created_at")

  /// Address the notification was actually delivered to. Null for rows created
  /// before this column existed, and for channels that have no address.
  recipient String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("notifications")
}

model Meeting {
  id          String @id @default(uuid())
  userId      String @map("user_id")
  fileName    String @map("file_name")
  /// Empty string for meetings created from a pasted transcript — those have
  /// no audio object behind them.
  fileUrl     String @map("file_url")
  /// Object key inside the "meetings" bucket, kept so transcription can sign a
  /// read URL without parsing it back out of fileUrl (mirrors Document).
  storagePath String? @map("storage_path")

  durationSeconds Int?    @map("duration_seconds")
  transcript      String?
  summary         String?
  /// Array of { task, assignee_guess, deadline_guess } produced by the single
  /// analysis AI call.
  actionItems     Json?   @map("action_items")
  /// Prisma scalar lists cannot be null — "none identified" is an empty array.
  attendees       String[]

  status        MeetingStatus @default(PENDING)
  /// Why transcription or analysis fell short, surfaced to the UI.
  statusMessage String?       @map("status_message")
  createdAt     DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("meetings")
}

model ScheduledJob {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  cronExpr   String   @map("cron_expr")
  nextRun    DateTime @map("next_run")
  isActive   Boolean  @default(true) @map("is_active")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("scheduled_jobs")
}

model ApiConnection {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  provider String
  config   Json
  isActive Boolean @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id])

  @@map("api_connections")
}
